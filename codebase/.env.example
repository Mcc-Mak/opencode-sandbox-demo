# Port exposed to the host (mapped to the container's published port).
PORT=8080

# Host port for the OpenCode web UI (the container uses opencode's default
# internal port; this only controls the host-side mapping).
OPENCODE_PORT=61211

# Network interface the published port binds to.
# Use 0.0.0.0 for all interfaces, or 127.0.0.1 for localhost-only.
NIC=127.0.0.1

# Tag applied to the built container image.
IMAGE_TAG=latest

# API key for the HKO AI model (zai-org/GLM-5.2-FP8) reached via the LiteLLM
# gateway (https://litellm.services.hko.gov.hk). Read by opencode.json as
# {env:HKOAI_API_KEY}. Local-only: set it in codebase/.env (this file's
# gitignored copy). Never commit a real value, and never push it to CI or
# GitHub secrets.
HKOAI_API_KEY=
